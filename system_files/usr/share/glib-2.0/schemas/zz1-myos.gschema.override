# Prism の初期設定（Apple 風の見た目）
# Bazzite の zz0-* より後に読み込まれるので、こちらが優先される。
# ユーザーが設定アプリで変えた値はユーザー側が優先される。

[org.gnome.desktop.interface]
accent-color='blue'
gtk-theme='WhiteSur-Light'
icon-theme='Prism'
cursor-theme='WhiteSur-cursors'
font-name='Inter Variable 11'
document-font-name='Inter Variable 11'
font-antialiasing='grayscale'
font-hinting='slight'
clock-format='24h'
clock-show-weekday=true
enable-hot-corners=false
show-battery-percentage=true

enable-animations=true

# 効果音（tools/make_sounds.py で作ったもの）
[org.gnome.desktop.sound]
theme-name='myos'
event-sounds=true

[org.gnome.desktop.wm.preferences]
# 閉じる・最小化・最大化のボタンを左に並べる（信号機の配置）
button-layout='close,minimize,maximize:appmenu'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/myos/myos-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/myos/myos-dark.svg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/myos/myos-light.svg'

# トップバーとアクティビティ画面の見た目
[org.gnome.shell.extensions.user-theme]
name='WhiteSur-Light'

[org.gnome.mutter]
edge-tiling=true
dynamic-workspaces=true

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
natural-scroll=true

[org.gnome.shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'steam.desktop', 'io.github.myos.Assistant.desktop', 'myos-claude-code.desktop', 'org.gnome.Settings.desktop']

# 画面下中央に浮かぶ、すりガラス風の Dock
[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
extend-height=false
height-fraction=0.9
dash-max-icon-size=56
icon-size-fixed=true
custom-theme-shrink=true
apply-custom-theme=false
transparency-mode='FIXED'
background-opacity=0.35
running-indicator-style='DOTS'
show-trash=false
show-mounts=false
show-apps-at-top=false
show-show-apps-button=true
click-action='focus-or-appspread'
scroll-action='do-nothing'
hot-keys=false

# Dock・パネル・アプリ一覧の背景をすりガラス風にする
[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=true

[org.gnome.shell.extensions.blur-my-shell.panel]
blur=true

[org.gnome.shell.extensions.blur-my-shell.overview]
blur=true
